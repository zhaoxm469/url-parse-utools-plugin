{
  "main": "index.html",
  "preload": "preload/services.js",
  "logo": "logo.png",
  "development": {
    "main": "http://localhost:9099"
  },
  "$schema": "../node_modules/utools-api-types/resource/utools.schema.json",
  "features": [
    {
      "code": "url-parser",
      "explain": "URL参数解析",
      "cmds": ["URL解析", "参数解析", {
        "type": "regex",
        "label": "URL解析",
        "match": "/^(https?:\\/\\/)?(localhost|[\\w-]+(\\.[\\w-]+)+)(:[0-9]{1,5})?([\\w.,@?^=%&:/~+#-]*[\\w@?^=%&/~+#-])?$/",
        "minLength": 8
      }]
    }
  ]
}
